{
  "claude-governance": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/bridge-pretooluse.js",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/bridge-sessionstart.js",
        "timeout": 35
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/bridge-preinvocation.js",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/bridge-stop.js",
        "timeout": 30
      }
    ]
  }
}
